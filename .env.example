# Copy to .env and fill in. .env is gitignored — never commit it.

# "local" runs fully offline: no AWS calls, no cost, fixtures instead of OCR.
# "aws" enables the Textract/Bedrock/DynamoDB/S3 adapters.
PROVIDER=local

# Only read when PROVIDER=aws.
# Do NOT put AWS keys here — use `aws configure sso` locally, an IAM role on
# Lambda.
AWS_REGION=us-east-1

# Second reader. Copy the inference profile ID verbatim from the Bedrock
# console; keep a geo prefix like "us." rather than "global.", which is what
# pins where a bill can travel. Any Converse-capable vision model works,
# e.g. us.amazon.nova-2-lite-v1:0. Leave empty to run on Textract alone.
BEDROCK_INFERENCE_PROFILE_ID=

# Created by your own `sam deploy`. Leave empty for local mode.
S3_BUCKET=
DDB_TABLE=

# Your deployed frontend's origin, added to the CORS allowlist. Never "*" —
# this API hands back a user's uploaded bill. Empty for local; localhost is
# already allowed.
FRONTEND_ORIGIN=

# Audit thresholds. These are what keep false reds at zero — read the
# rationale in docs/architecture.md before changing any of them.
GST_PERCENT=12
RED_EXCESS_FRACTION=0.25
RED_MIN_AMOUNT_AFFECTED=50
RED_MAX_RATIO=50

# Retrieval date of the NPPA lists in data/raw/. Shown next to every verdict.
REFERENCE_RETRIEVED_ON=2026-09-18
