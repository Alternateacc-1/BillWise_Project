# BillWise configuration. Copy to .env and fill in. NEVER commit .env.
#
# .env is gitignored. If you ever paste a real key into a file that is not
# .env, assume it is compromised and rotate it.

# ---------------------------------------------------------------------------
# Provider switch. "local" runs fully offline with zero AWS calls and zero
# cost. "aws" enables the Textract/Bedrock/DynamoDB/S3 adapters.
# ---------------------------------------------------------------------------
PROVIDER=local

# ---------------------------------------------------------------------------
# AWS. Only read when PROVIDER=aws.
#
# Do NOT put AWS keys here. Use `aws configure sso` locally and an IAM role on
# Lambda. These variables exist so the code never has to guess a region or a
# model id.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# Cross-region inference profile ID for the second reader, copied VERBATIM
# from the Bedrock console (Bedrock > Inference and assessment > Cross-region
# inference). Do not hand-type it and do not guess the prefix.
#
# Keep a geo prefix such as "us." rather than "global.". A geo profile routes
# to a small, fixed set of Regions that infra/template.yaml pins in IAM;
# "global." routes to far more and its list can change. For a document that
# is somebody's medical bill, that pin is the data-residency control.
#
# The reader uses Bedrock's Converse API, which is model-agnostic, so any
# Converse-capable vision model works here, e.g. us.amazon.nova-2-lite-v1:0.
BEDROCK_INFERENCE_PROFILE_ID=

# Created by your own `sam deploy` -- see docs/aws-deployment.md. Leave empty for
# local mode.
S3_BUCKET=
DDB_TABLE=

# The origin your frontend is served from, added to the CORS allowlist when
# PROVIDER=aws. Set this to YOUR OWN deployed frontend URL, e.g.
# https://prod.d1a2b3c4.amplifyapp.com -- never "*", because this API hands
# back a user's uploaded bill. Leave empty for local development; localhost
# is already allowed.
FRONTEND_ORIGIN=

# ---------------------------------------------------------------------------
# Audit tuning. Rationale for every number is in backend/app/config.py and
# docs/architecture.md. Do not change these without reading that rationale --
# they are what keeps false reds at zero.
# ---------------------------------------------------------------------------
GST_PERCENT=12
RED_EXCESS_FRACTION=0.25
RED_MIN_AMOUNT_AFFECTED=50
RED_MAX_RATIO=50

# Date the NPPA price lists in data/raw/ were retrieved. Shown to the user
# next to every verdict.
REFERENCE_RETRIEVED_ON=2026-09-18
