.env
.env.*
!.env.example
*.pem
*.key
credentials
aws_credentials
.aws/

# --- python ---
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- node / frontend ---
node_modules/
frontend/dist/
.vite/

# --- downloaded data (not ours to redistribute) ---
data/raw/brands/

# Derived from the gitignored brand dataset: 36 MB, and regenerable with
# two commands (fetch_brand_data.py then build_brand_index.py). The small
# build report IS committed so the numbers are reviewable without it.
data/reference/brand_index.csv

# --- local runtime artefacts ---
data/blobs/
# SQLite writes THREE files in WAL mode. `*.sqlite` alone misses the -shm and
# -wal siblings, and those two were tracked until 2026-09-18 -- a WAL holds the
# same bill rows the database does, so ignoring only the .sqlite file would let
# a processed bill reach git. Match the siblings explicitly.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
.aws-sam/
samconfig.toml

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Staged into the Lambda bundle by scripts/stage_lambda.py
backend/reference_data/*
backend/fixtures/

# ...with ONE exception. The reduced brand index (12.9 MB of the 36 MB source)
# is committed, because without it a fresh clone cannot resolve brand names and
# eval/run_eval.py FAILS -- Augmentin, Acimol and PANTOCID DSR all go unmatched.
# Rebuilding it needs a 254k-row network download, so shipping it is the
# difference between `git clone && pytest` working and not. It is derived from
# the MIT-licensed Indian Medicine Dataset, credited in README.
# stage_lambda.py rewrites this file deterministically, so any git diff here
# means the reduction actually changed -- which is worth seeing.
!backend/reference_data/brand_index.csv

# The frontend hand-off archive. 33 MB, and it carries screenshots and a
# WhatsApp photo that may show a real bill -- which must never enter this
# repo. The code was extracted to frontend/; the archive itself stays out.
claude.zip
frontend_old/

# Build output zipped for an Amplify manual deploy. Regenerate, never commit.
billwise-frontend.zip

# The share archive, built with git archive. Regenerate, never commit.
billwise-handoff.zip

# Frontend delivered by the contributor as a zip (2026-09-20). Byte-identical pair; the
# source that mattered is integrated and logged in docs/CHANGES_BY_contributor.md.
frontend-v2.zip
frontend-handoff-b.zip

# the contributor's working copy of the whole project, delivered as a folder (2026-09-20).
# His frontend is integrated into frontend/ and his log is docs/CHANGES_BY_contributor.md.
# NEVER COMMIT THIS FOLDER: data/blobs/ inside it holds REAL uploaded bills, and
# it carries its own .env. Keep it out of the repo, not just out of `git add -A`.
handoff/

# The demo bills are GENERATED, not committed. scripts/make_demo_bills.py emits
# them from the same declaration that produces eval/fixtures/ and
# eval/ground_truth/, so shipping the output as well would be a second copy
# that can drift. They are synthetic -- fake hospital, no patient names -- but
# the repo carries no bill files at all, which is the simpler thing to promise.
eval/demo_bills/

# Per-developer editor/tooling config. launch.json hardcodes this machine's
# node and venv paths, which differ on every box and break outright on
# Linux/macOS. The commands it wraps are in the README.
.vscode/
